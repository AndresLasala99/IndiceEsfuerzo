# Puerto local (Render lo asigna solo en producción)
PORT=4000

# Cadena de conexión de MongoDB Atlas
MONGODB_URI=mongodb+srv://usuario:clave@cluster.xxxxx.mongodb.net/ise?retryWrites=true&w=majority

# Texto largo y aleatorio para firmar las sesiones
JWT_SECRET=cambiar-por-un-texto-largo-y-aleatorio

# Código que hay que escribir para registrarse como administrador
ADMIN_CODE=cambiar-este-codigo

# URL del frontend (Vercel). Si hay más de una, separarlas con coma
CLIENT_URL=http://localhost:5173
